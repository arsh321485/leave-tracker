APP_ENV=development

# Supabase Postgres (Prisma)
# Dashboard → Project Settings → Database → Connection string
# Use Transaction pooler for DATABASE_URL, Direct for DIRECT_URL (migrations)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres

# Supabase JS client (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-secret
AUTH_SECRET=change-me-to-a-long-random-secret

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_APP_TOKEN=
SLACK_LEAVE_CHANNEL_ID=

BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional: treat weekends as non-working (default true)
WEEKENDS_NON_WORKING=true
